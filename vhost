<VirtualHost *:80>
    ServerName cfs.tpct.com.tw
    DocumentRoot "c:/wamp64/www/TPCT-WMS-Service"

    <Directory "c:/wamp64/www/TPCT-WMS-Service">
        Options +Indexes +Includes +FollowSymLinks +MultiViews
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>

<VirtualHost *:443>
    ServerName cfs.tpct.com.tw
    DocumentRoot "c:/wamp64/www"

    SSLEngine on
    #SSLCertificateFile "c:/wamp64/bin/apache/apache2.4.62.1/conf/SSL/2024-11-21/server.crt"
    SSLCertificateFile "c:/wamp64/bin/apache/apache2.4.62.1/conf/SSL/20260915/fullchain.pem"
    #SSLCertificateKeyFile "c:/wamp64/bin/apache/apache2.4.62.1/conf/SSL/2024-11-21/UPserver.key"
    SSLCertificateKeyFile "c:/wamp64/bin/apache/apache2.4.62.1/conf/SSL/20260915/TPCT2027.key"
    
    RedirectMatch ^/$ /TPCT-WMS-Service/login
    
     <Directory "c:/wamp64/www/TPCT-WMS-Service">
        Options +Indexes +Includes +FollowSymLinks +MultiViews
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>


RedirectMatch 403 ^.+\.(env|xml|json|example)$
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    ## force http to https
    RewriteCond %{SERVER_PORT} 80
    RewriteRule ^(.*)$ https://cfs.tpct.com.tw/TPCT-WMS-Service/ [R=301,L]

    ##RewriteCond %{HTTPS} !=on
    ##RewriteRule ^(.*)$ https://cfstest.tpct.com.tw/TPCT-WMS-Service/$1 [R=301,L]


    # Handle Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

